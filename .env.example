# =============================================================================
# WatchFlowing — production environment
# Copy to .env.local (dev) or set in Vercel Project Settings (prod).
# Never commit real secrets.
# =============================================================================

# Database (Supabase PostgreSQL — Prisma)
# Use Supavisor pooler (IPv4). Quote values when using ?pgbouncer=true
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Clerk Authentication (use pk_live_ / sk_live_ in production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# App URL (must be the public brand domain — used for Stripe redirects + emails)
NEXT_PUBLIC_APP_URL=https://watchflowing.com

# Admin bootstrap (comma-separated emails → role=ADMIN on login).
# Founder admin karpenkoivanb@gmail.com is always included in code; add more here.
ADMIN_EMAILS=you@yourdomain.com

# AI Provider (openai | claude | gemini)
AI_PROVIDER=gemini
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional chat models (defaults applied if unset)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL_FAST=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# Stripe (use live keys + live Price IDs for public launch)
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook endpoint: https://watchflowing.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*
# Customer Portal: https://dashboard.stripe.com/settings/billing/portal
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# Resend (verify domain before launch)
# RESEND_FROM_EMAIL must be a verified sender, e.g.:
# WatchFlowing Notifications <notifications@watchflowing.com>
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=WatchFlowing Notifications <notifications@watchflowing.com>

# Telegram Bot (server-side only). Production webhook:
# https://watchflowing.com/api/telegram/webhook
#
# Required (canonical names — use these on Vercel):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=WatchFlowAlertsBot
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
#
# Also required for webhook registration URL:
# NEXT_PUBLIC_APP_URL=https://watchflowing.com
#
# Optional dedicated HMAC for Telegram link codes (falls back to webhook/cron secret)
# TELEGRAM_LINK_SECRET=
#
# Legacy aliases accepted in code (prefer canonical names above):
# TELEGRAM_TOKEN, TG_BOT_TOKEN
# TELEGRAM_SECRET_TOKEN, TELEGRAM_WEBHOOK_TOKEN, TELEGRAM_SECRET
# TELEGRAM_USERNAME, TG_BOT_USERNAME

# Cron (required for /api/cron/* — Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# Monitoring cron in vercel.json is daily (0 6 * * *) so a Hobby deploy succeeds.
# A per-minute expression (* * * * *) is rejected on Hobby and fails the whole deployment.
# Frequent checks run on the machine with Scrapling: npm run monitor:worker
# Set MONITOR_WORKER_URL to that machine's public https URL if Vercel should trigger it.
# GitHub Actions (.github/workflows/monitoring-tick.yml) calls production every 5 minutes
# when this same CRON_SECRET is stored in the repository secrets.
# Set MONITOR_TICK_SOURCE=github only after that secret exists, so the product
# reports a 5-minute tick instead of the daily platform schedule.
# MONITOR_TICK_SOURCE=github
# maxDuration 120 also requires Pro. Overlapping runs rely on MonitorQueue locks.
# Set MONITOR_WORKER_URL to a machine that has Scrapling. Vercel then only triggers
# POST /run and does not launch Chromium inside the function.
# MONITOR_WORKER_URL=https://your-worker.example
# MONITOR_WORKER_PORT=8787
# MONITOR_WORKER_HOST=127.0.0.1
CRON_SECRET=generate-a-long-random-secret

# Encrypts per-monitor session cookies (AES-256-GCM). Falls back to CRON_SECRET if unset.
# MONITOR_SESSION_SECRET=generate-a-long-random-secret

# Rate limiting — REQUIRED in production (multi-instance safe). Without Upstash,
# limits fall back to per-instance memory and can be bypassed across Vercel replicas.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Optional Chromium override for Vercel serverless (Playwright fallback only)
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar

# Scrapling engine. Leave unset to use the project virtualenv created by npm run scrapling:install.
# MONITOR_FETCH_ENGINE=scrapling
# SCRAPLING_PYTHON=
# Optional operator proxy for the advanced browser strategy. Not used to bypass blocks.
# MONITOR_PROXY_URL=
# Optional Amazon Creators API (official product data). Do not put these in NEXT_PUBLIC_ variables.
# Credential version selects the OAuth token host: 3.1 North America, 3.2 Europe, 3.3 Far East.
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_VERSION=3.2
# AMAZON_ASSOCIATES_PARTNER_TAG=
# AMAZON_MARKETPLACE=www.amazon.de

# Optional eBay Browse API. Production is used only when EBAY_ENVIRONMENT=production.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_ENVIRONMENT=sandbox
# EBAY_MARKETPLACE_ID=EBAY_DE

# Optional Etsy Open API v3 key. Listings are not opened in a browser without it.
# ETSY_API_KEY=
